{
  "name": "urnik-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "bundle": "ncc build dist/src/main.js -o bundle",
    "bundle:patch": "node -e \"const fs=require('fs'),glob=require('fs').readdirSync('bundle').filter(f=>f.endsWith('.js'));let n=0;for(const f of glob){const fp='bundle/'+f,c=fs.readFileSync(fp,'utf-8'),p=c.replace(/import\\.meta\\.resolve\\(([^)]+)\\)/g,'require.resolve($1)');if(c!==p){fs.writeFileSync(fp,p);n++;console.log('Patched:',f)}}console.log(n,'file(s) patched');\"",
    "migrate": "mikro-orm migration:up",
    "migrate:create": "mikro-orm migration:create",
    "migrate:status": "mikro-orm migration:list",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.1.13",
    "@mikro-orm/decorators": "^7.1.13",
    "@mikro-orm/migrations": "^7.1.13",
    "@mikro-orm/mysql": "^7.1.13",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/reflection": "^7.1.13",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@scalar/nestjs-api-reference": "^1.0.7",
    "cache-manager": "^7.2.4",
    "cheerio": "^1.1.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "ics": "^3.8.1",
    "ics-service": "^1.4.0",
    "jsdom": "^27.0.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "nodemailer": "^7.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "^7.1.13",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/date-fns": "^2.6.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "entities": "^6.0.0"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
